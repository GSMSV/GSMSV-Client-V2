# Public GSMSV API origin used by the browser.
# - Local dev/preview: leave empty. Vite proxies /api to API_PROXY_TARGET (same-origin, no CORS).
# - Production: set VITE_API_ORIGIN=https://gsmsv-api.https.gsmsv.site in the hosting env.
#   Serve the frontend from a *.gsmsv.site host (server cookies are SameSite=Lax) and allow it in server CORS.
VITE_API_ORIGIN=

# Local dev/preview only: backend that Vite proxies /api to (not exposed to the browser).
API_PROXY_TARGET=https://gsmsv-api.https.gsmsv.site

# Optional demo SSH pool. Set only after V1 VMs are reachable. JSON array of
# {"host":"<public host>","port":<port>,"user":"<account>"} in allocation order.
# Public browser config: never put a password, private key, or token here.
VITE_DEMO_SSH_SLOTS=
